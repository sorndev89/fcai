{
  "name": "facebook-chat-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for Facebook AI Chatbot SaaS (unified server with frontend)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n BE,FE -c cyan,yellow \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npx -y kill-port 5002 && nodemon --watch src --ext ts --delay 1 --exec tsx src/index.ts",
    "dev:frontend": "npm run dev --prefix ../frontend",
    "build": "node scripts/build.js",
    "build:frontend": "npm run build --prefix ../frontend",
    "build:backend": "tsc",
    "start": "node dist/index.js",
    "start:dev": "concurrently -k -n BE,FE -c cyan,yellow \"tsx src/index.ts\" \"npm run start:nitro\"",
    "start:nitro": "node ../../frontend/.output-dist/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "http-proxy-middleware": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.21.4",
    "esbuild": "^0.20.2",
    "nodemon": "^3.1.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^3.0.0"
  }
}
